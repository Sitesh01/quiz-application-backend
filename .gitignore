#############################
#   BUILD & DEPENDENCIES   #
#############################

# Maven build directories
target/
build/
out/

# Maven wrapper files
.mvn/
mvnw
mvnw.cmd

# Exclude JARs / WARs
*.jar
*.war
*.ear

################################
#   SPRING BOOT CONFIG FILES   #
################################

# DO NOT upload application.properties/yml (contains DB passwords)
src/main/resources/application.properties
src/main/resources/application.yml
src/main/resources/application-dev.properties
src/main/resources/application-prod.properties

# If you use environment-specific configs
*.env

#############################
#        JAVA / IDE         #
#############################

# Compiled class files
*.class

# Log files
*.log

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/

# Eclipse / STS
.classpath
.project
.settings/
.springBeans
.sts4-cache
.apt_generated
.factorypath

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

#############################
#        OPERATING SYS      #
#############################

# macOS
.DS_Store

# Windows
Thumbs.db

#############################################
#   OTHER FILES GENERATED BY FRAMEWORKS     #
#############################################

# Lombok delombok directory
delombok/

# Temporary files
*.tmp
*.cache
*.swp
*.swo

#############################################
#      LOGS / UPLOADS / TEMP DIRECTORIES    #
#############################################

/logs/
/uploads/
/temp/
/tmp/

#############################################
#      KEEP SPECIFIC SUBDIRECTORIES         #
#############################################

!**/src/main/**/build/
!**/src/test/**/build/
